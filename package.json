{
  "name": "aiops-zotero-mcp",
  "version": "0.8.0",
  "private": true,
  "description": "MCP server inside Zotero: manage and research your library from AI agents (localhost only, token auth)",
  "license": "MIT",
  "author": "Sacha Wharton",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachajw/aiops-zotero-mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:live": "vitest run tests/live"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fflate": "0.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
